{
  "name": "payoux",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd=apps/portail dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "e2e": "bun run --cwd=apps/portail e2e"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "packageManager": "bun@1.4.4"
}
